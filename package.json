    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "tsx tools/db-migrate.ts",

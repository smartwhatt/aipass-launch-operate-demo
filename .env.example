# ---------------------------------------------------------------------------
# ถามคู่มือ — ศูนย์บริการตัวอย่าง / AIPASS demo application
#
# Copy this file to .env.local (development) or set the same names in the
# hosting provider. Never commit a filled copy. Never prefix a secret with
# NEXT_PUBLIC_.
#
# Required server configuration, per IMPLEMENTATION_SPEC.md section 4.
# ---------------------------------------------------------------------------

# local | preview | production
APP_ENV=local

# Isolated data for one deployment environment, for example aipass-local.
DATA_NAMESPACE=aipass-local

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aipass_local

# Signing secret for session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# fixture | live
AI_MODE=fixture

# Required only for live mode. Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Acknowledge that live model prices were checked against the provider price
# page on the date in lib/providers/pricing.ts. Without this flag live calls
# still run, but the admin screens show an unverified-pricing warning.
LIVE_PRICING_CONFIRMED=false

# Set to true only in a dedicated course sandbox. A general learner
# deployment must set this to false: it hides demo controls and refuses resets.
DEMO_CONTROLS_ENABLED=true

# Initial scenario mode for seeding only. Active controls live in PostgreSQL.
DEMO_MODE=normal

# Initial seed defaults only. The active index pointer lives in PostgreSQL.
DOCS_VERSION=docs-v1
INDEX_VERSION=index-v1

# Actual application release identifier. Must equal package.json version.
APP_VERSION=1.0.0

# Optional: shown on the release record. Vercel sets VERCEL_GIT_COMMIT_SHA.
APP_COMMIT=
